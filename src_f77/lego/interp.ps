3 hp
border
hborder
/x0 x 0 get bm add def
/y0 y 0 get bm bfs add hs add sub def
x0 y0 moveto
bf setfont
(      +              \(TRAY\(J2,L,M\)-TRAY\(J2-1,L,M\)\)) s
( ) s
( C---           Interpolate the second derivative and find the intrp value:) s
(                CALL SPLINE\(TRAY\(J1,L,M\),RWRK,JD,DER1,DER2,DERIV\)) s
(                CALL SPLINT\(TRAY\(J1,L,M\),RWRK,DERIV,JD,TIME,GS\)) s
(                PRAY\(N,MAXEL,L,M\) = GS ) s
(             ENDDO) s
( C----------------------------------------------------------------------) s
( ) s
( ) s
( C----------------------------------------------------------------------) s
( C  Value 4: Group velocity) s
( C----------------------------------------------------------------------) s
(             ) s
(             DO N=1,3) s
( C---           Initialize the work table containing the function values) s
(                K = J1) s
(                DO I=1,JD) s
(                   RWRK\(I\) = VGRAY\(N,K,L,M\)) s
(                   K = J1+I) s
(                ENDDO) s
(                ) s
(                DER1 = \(VGRAY\(N,J1+1,L,M\)-VGRAY\(N,J1,L,M\)\)/) s
(      +              \(TRAY\(J1+1,L,M\)-TRAY\(J1,L,M\)\)) s
(                DER2 = \(VGRAY\(N,J2,L,M\)-VGRAY\(N,J2-1,L,M\)\)/) s
(      +              \(TRAY\(J2,L,M\)-TRAY\(J2-1,L,M\)\)) s
( ) s
( C---           Interpolate the second derivative and find the intrp value:) s
(                CALL SPLINE\(TRAY\(J1,L,M\),RWRK,JD,DER1,DER2,DERIV\)) s
(                CALL SPLINT\(TRAY\(J1,L,M\),RWRK,DERIV,JD,TIME,GS\)) s
(                VGRAY\(N,MAXEL,L,M\) = GS ) s
(             ENDDO) s
( C----------------------------------------------------------------------) s
( ) s
( ) s
( C----------------------------------------------------------------------) s
( C  Value 5: Matrix Q2   Q2RAY\(3,2,MAXEL,NTH,NPH\)) s
( C----------------------------------------------------------------------) s
(             DO H=1,2) s
(                DO N=1,3) s
( C---              Initialize the work table containing the function values) s
(                   K = J1) s
(                   DO I=1,JD) s
(                      RWRK\(I\) = Q2RAY\(N,H,K,L,M\)) s
(                      K = J1+I) s
(                   ENDDO) s
(                ) s
(                   DER1 = \(Q2RAY\(N,H,J1+1,L,M\)-Q2RAY\(N,H,J1,L,M\)\)/) s
(      +                 \(TRAY\(J1+1,L,M\)-TRAY\(J1,L,M\)\)) s
(                   DER2 = \(Q2RAY\(N,H,J2,L,M\)-Q2RAY\(N,H,J2-1,L,M\)\)/) s
(      +                 \(TRAY\(J2,L,M\)-TRAY\(J2-1,L,M\)\)) s
( ) s
( C---              Interpolate the second derivative and find the intrp value:) s
(                   CALL SPLINE\(TRAY\(J1,L,M\),RWRK,JD,DER1,DER2,DERIV\)) s
(                   CALL SPLINT\(TRAY\(J1,L,M\),RWRK,DERIV,JD,TIME,GS\)) s
(                   Q2RAY\(N,H,MAXEL,L,M\) = GS ) s
(                ENDDO) s
(             ENDDO) s
( C----------------------------------------------------------------------) s
( ) s
( ) s
( C----------------------------------------------------------------------) s
( C  Value 6: Matrix P2   P2RAY\(3,2,MAXEL,NTH,NPH\)) s
( C----------------------------------------------------------------------) s
(             DO H=1,2) s
(                DO N=1,3) s
( C---              Initialize the work table containing the function values) s
(                   K = J1) s
(                   DO I=1,JD) s
/sd 1 def
4 hp
border
hborder
/x0 x 1 get bm add def
/y0 y 1 get bm bfs add hs add sub def
x0 y0 moveto
bf setfont
(                      RWRK\(I\) = P2RAY\(N,H,K,L,M\)) s
(                      K = J1+I) s
(                   ENDDO) s
(                ) s
(                   DER1 = \(P2RAY\(N,H,J1+1,L,M\)-P2RAY\(N,H,J1,L,M\)\)/) s
(      +                 \(TRAY\(J1+1,L,M\)-TRAY\(J1,L,M\)\)) s
(                   DER2 = \(P2RAY\(N,H,J2,L,M\)-P2RAY\(N,H,J2-1,L,M\)\)/) s
(      +                 \(TRAY\(J2,L,M\)-TRAY\(J2-1,L,M\)\)) s
( ) s
( C---              Interpolate the second derivative and find the intrp value:) s
(                   CALL SPLINE\(TRAY\(J1,L,M\),RWRK,JD,DER1,DER2,DERIV\)) s
(                   CALL SPLINT\(TRAY\(J1,L,M\),RWRK,DERIV,JD,TIME,GS\)) s
(                   P2RAY\(N,H,MAXEL,L,M\) = GS ) s
(                ENDDO) s
(             ENDDO) s
( C----------------------------------------------------------------------) s
( ) s
( ) s
( C----------------------------------------------------------------------) s
( C  Value 7: Ray polarization vector) s
( C----------------------------------------------------------------------) s
(             H = KMODE\(1\)) s
(             DO N=1,3) s
( C---  Initialize the work table containing the function values) s
(                K = J1) s
(                DO I=1,JD) s
(                   RWRK\(I\) = GVRAY\(N,H,K,L,M\)) s
(                   K = J1+I) s
(                ENDDO) s
(                ) s
(                DER1 = \(GVRAY\(N,H,J1+1,L,M\)-GVRAY\(N,H,J1,L,M\)\)/) s
(      +              \(TRAY\(J1+1,L,M\)-TRAY\(J1,L,M\)\)) s
(                DER2 = \(GVRAY\(N,H,J2,L,M\)-GVRAY\(N,H,J2-1,L,M\)\)/) s
(      +              \(TRAY\(J2,L,M\)-TRAY\(J2-1,L,M\)\)) s
(                ) s
( C---  Interpolate the second derivative and find the intrp value:) s
(                CALL SPLINE\(TRAY\(J1,L,M\),RWRK,JD,DER1,DER2,DERIV\)) s
(                CALL SPLINT\(TRAY\(J1,L,M\),RWRK,DERIV,JD,TIME,GS\)) s
(                GVRAY\(N,H,MAXEL,L,M\) = GS ) s
(             ENDDO) s
( ) s
( C----------------------------------------------------------------------) s
( ) s
( ) s
( C----------------------------------------------------------------------) s
( C  Value 8: KMAH index) s
( C----------------------------------------------------------------------) s
( ) s
( ) s
(             IND = 0) s
( ) s
(             DO I=1,J) s
(                IND=IND+KINDX\(I,L,M\)) s
(             ENDDO) s
(             ) s
(             KMAH\(L,M\) = INT\(IND\)) s
( ) s
( ) s
( ) s
(             WRITE\(6,*\) ' INTERP: KMAH = ', KMAH\(L,M\)) s
( ) s
( ) s
( ) s
( C----------------------------------------------------------------------) s
( ) s
(          ENDDO   ! main loop over ray takeoff angles) s
(       ENDDO      ! main loop over ray takeoff angles) s
( ) s
( ) s
/sd 0 def
2 sn
fnf
lg lgp
pagesave restore
showpage
